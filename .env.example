# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Postgres or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/screening_db
# For zero-setup local dev without Docker Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./screening.db

# Vector Index Directory
INDEX_DIR=./data/indexes
CORPUS_DIR=./data/corpus

# Model configuration
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Interview Configuration
MAX_QUESTIONS_PER_SESSION=6
TOPICS_TARGET_DEPTH=1
